SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# ASP.NET Core maps this to ConnectionStrings:PostgreSQL
ConnectionStrings__PostgreSQL="Host=aws-0-REGION.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project-ref;Password=your-db-password;SSL Mode=Require;Trust Server Certificate=true;Max Auto Prepare=0;GSS Encryption Mode=Disable"

# Frontend origin used in invite emails / invite links (no trailing slash)
App__PublicAppBaseUrl=https://split-bill-five-gules.vercel.app
